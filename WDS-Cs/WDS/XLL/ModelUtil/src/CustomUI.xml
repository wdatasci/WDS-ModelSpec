<customUI xmlns='http://schemas.microsoft.WDS/office/2009/07/customui' loadImage='LoadImage'>
    <ribbon>
        <tabs>
            <tab id='WDSModelUtilTab' label='WDS'>
                <group id='WDSGroup0' label='About'>
                    <button id='Button0' 
                        image='WDataSciMark1300x240' 
                        size='large' 
                        onAction='RunTagMacro' 
                        tag='ShowAboutForm' 
                        />
                </group>
                <group id='WDSGroup1' label='WDS Workbook Helpers'>
                    <menu id='WDSGroup1M1' label='WDSCore VBA' image='WDataSciMark1300x240'>
                        <button id='Button1M1_1' 
                            label='Add VBA Module: WDSCore' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='AddWDSCoreVBAModule'
                            />
                        <button id='Button1M1_2' 
                            label='Remove VBA Module: WDSCore' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='RemoveWDSCoreVBAModule' 
                            />
                    </menu>
                    <menu id='WDSGroup1M2' label='JniPMML VBA' image='WDataSciMark1300x240'>
                        <button id='Button1M2_1' 
                            label='Add VBA Module: WDSJniPMML' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='VBAComponentAdd_WDSJniPMML' 
                            />
                        <button id='Button1M2_2' 
                            label='Remove VBA Module: WDSJniPMML' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='VBAComponentRemove_WDSJniPMML' 
                            />
                    </menu>
                    <menu id='WDSGroup1M3' label='VBA Project' image='WDataSciMark1300x240'>
                        <button id='Button1M3_3' 
                            label='VBA Module Check Sheet' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='VBACheck' 
                            />
                        <button id='Button1M3_4' 
                            label=' -- Refresh VBA Module Check Sheet' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='VBACheckRefresh' 
                            />
                        <button id='Button1M3_5' 
                            label=' -- Import External Selections From Check Sheet' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='VBAImportSelected' 
                            />
                        <button id='Button1M3_6' 
                            label=' -- Export Local Selections From Check Sheet' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='VBAExportSelected' 
                            />
                        <button id='Button1M3_7' 
                            label=' -- Remove Local Selections From Check Sheet' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='VBARemoveSelected' 
                            />
                        <button id='Button1M3_8' 
                            label='Remove VBA Module Check Sheet' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='VBACheckRemove' 
                            />
                    </menu>
                    <menu id='WDSGroup1M3' label='ListObjects' image='WDataSciMark1300x240'>
                        <button id='Button1M3_1' 
                            label='Add XmlMap To Selected ListObject' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='JniPMML_XmlMap_Helper' 
                            />
                    </menu>
                </group>
                <group id='WDSDModelUtil' label='WDS ModelUtil'>
                    <menu id='WDSGroup2M1' label='DNSM' image='WDataSciMark1300x240'>
                        <button id='Button2M1_1' 
                            label='Build new workbook' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='BuildNewDNSMWorkbook' 
                            />
                        <button id='Button2M1_2' 
                            label='TBD' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='TBD'
                            />
                    </menu>
                </group>
                <group id='WDSGroup3' label='WDS HDF5/FlatFile'>
                    <menu id='WDSGroup3M1' label='HDF5' image='WDataSciMark1300x240'>
                        <button id='Button3M1_1' 
                            label='Export XMLMapped List To HDF5' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='ExportXMLMappedListToHDF5' 
                            />
                        <button id='Button3M1_2' 
                            label='Import HDF5 CompoundDS Type' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='ImportHDF5CompoundDS'
                            />
                    </menu>
                    <menu id='WDSGroup3M2' label='FlatFile' image='WDataSciMark1300x240'>
                        <button id='Button3M2_1' 
                            label='Export XMLMapped ListObject To CSV' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='ExportXMLMappedListToCSV' 
                            />
                        <button id='Button3M2_2' 
                            label='Import CSV to ListObject' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='ImportCSVToXMLMappedList'
                            />
                    </menu>
                </group>
                <group id='WDSGroup4' label='WDS JniPMML'>
                    <menu id='WDSGroup4M1' label='JniPMML' image='WDataSciMark1300x240'>
                        <button id='Button4M1_1' 
                            label='Add XmlMap To Selected ListObject' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='JniPMML_XmlMap_Helper' 
                            />
                        <button id='Button4M1_2' 
                            label='Evaluate XMLMapped List Via JniPMML' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='JniPMML_Eval_XmlMappedList'
                            />
                        <button id='Button4M1_3' 
                            label='JniPMML Java Cmd Line Call Prep' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='JniPMML_Cmd_Prep'
                            />
                        <button id='Button4M1_4' 
                            label='JniPMML Java Cmd Line Call' 
                            image='WDataSciMark1300x240' 
                            onAction='RunTagMacro' 
                            tag='JniPMML_Cmd'
                            />
                    </menu>
                </group>
            </tab>
        </tabs>
    </ribbon>
</customUI>
